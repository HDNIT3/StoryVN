# Copy these values into backend/.env only when opting into the search pilot.
# false = no new endpoints, index writes, timers, workers or model downloads.
SEMANTIC_SEARCH_ENABLED=false

# First setup only: true downloads the public ONNX model, not a paid API.
# After caching the model, use false for offline runtime.
SEARCH_ALLOW_MODEL_DOWNLOAD=false
SEARCH_MODEL_CACHE_DIR=.cache/semantic-search
SEARCH_MAX_STORIES=2000
SEARCH_SYNC_INTERVAL_MS=60000
SEARCH_QUERY_TIMEOUT_MS=1200
